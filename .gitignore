# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Vite ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Secrets and local config ---
# provision_app_registrations.py and provision_seeder_app.py print secrets once;
# they must never be committed. The .example files are the ones to track.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Build stamps and deployment artefacts ---
.tag
*.log

# --- Azure / IaC state ---
.azure/
.terraform/
*.tfstate
*.tfstate.*

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.vscode/launch.json

# --- Bank brand packs ---
# Only the fictional CFC Bank pack ships with the repo. Real bank packs are
# fetched at deploy time by tools/brand/fetch_brand.py and stay local.
app/src/web/public/brand/*
!app/src/web/public/brand/cfc/
!app/src/web/public/brand/favicon.png
