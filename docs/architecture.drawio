        <mxCell id="e13" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A1A1AA;strokeWidth=1;dashed=1;fontSize=9;fontColor=#71717A;endArrow=block;endFill=1;" edge="1" parent="1" source="bff" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="334" /><mxPoint x="862" y="581" /></Array></mxGeometry></mxCell>

        <!-- ================= LEGEND ================= -->
        <mxCell id="legendbox" value="Legend"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8D4D0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#52525B;arcSize=6;"
          vertex="1" parent="1"><mxGeometry x="60" y="770" width="700" height="120" as="geometry" /></mxCell>

        <mxCell id="lg1" value="Identity / On-Behalf-Of — the user's own permissions apply downstream"
          style="text;html=1;fontSize=11;fontColor=#7F1D1D;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="800" width="480" height="18" as="geometry" /></mxCell>
        <mxCell id="lgl1" style="endArrow=none;html=1;strokeColor=#EC111A;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="809" as="sourcePoint" /><mxPoint x="103" y="809" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="lg2" value="Request path — browser → APIM → web → BFF → agent"
          style="text;html=1;fontSize=11;fontColor=#1F4E79;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="826" width="480" height="18" as="geometry" /></mxCell>
        <mxCell id="lgl2" style="endArrow=none;html=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="835" as="sourcePoint" /><mxPoint x="103" y="835" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="lg3" value="Grounding — the agent decides which IQ layers to call per question"
          style="text;html=1;fontSize=11;fontColor=#8A5A12;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="852" width="480" height="18" as="geometry" /></mxCell>
        <mxCell id="lgl3" style="endArrow=none;html=1;strokeColor=#B45309;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="861" as="sourcePoint" /><mxPoint x="103" y="861" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Key design notes -->
        <mxCell id="notesbox" value="Design notes"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8D4D0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#52525B;arcSize=6;"
          vertex="1" parent="1"><mxGeometry x="790" y="770" width="1350" height="120" as="geometry" /></mxCell>

        <mxCell id="n1" value="• &lt;b&gt;No data migration.&lt;/b&gt; Mortgage servicing, the customer master and the risk model stay in place; Fabric mirrors them into OneLake as governed measures."
          style="text;html=1;fontSize=11;fontColor=#3D3D42;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="798" width="1310" height="18" as="geometry" /></mxCell>
        <mxCell id="n2" value="• &lt;b&gt;The BFF is never public.&lt;/b&gt; Internal ingress only; nginx proxies /api inside the Container Apps environment, so the client secret never faces the internet."
          style="text;html=1;fontSize=11;fontColor=#3D3D42;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="820" width="1310" height="18" as="geometry" /></mxCell>
        <mxCell id="n3" value="• &lt;b&gt;Work IQ is delegated.&lt;/b&gt; Calling the agent with the app identity would return an empty but plausible answer — which is why On-Behalf-Of is a functional requirement, not just access control."
          style="text;html=1;fontSize=11;fontColor=#3D3D42;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="842" width="1310" height="18" as="geometry" /></mxCell>
        <mxCell id="n4" value="• &lt;b&gt;Two RBAC planes.&lt;/b&gt; Entra app roles govern who may open the app; each data source independently authorises what that person may see."
          style="text;html=1;fontSize=11;fontColor=#3D3D42;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="864" width="1310" height="18" as="geometry" /></mxCell>

        <!-- Disclaimer -->
        <mxCell id="disclaimer" value="SYNTHETIC DEMO DATA — CFC Bank is used as a branding label only. No customer, balance, rate or policy shown here reflects real CFC Bank information. OSFI guideline numbers are real public guidelines cited by name only."
          style="text;html=1;fontSize=10;fontColor=#7C2D12;align=left;verticalAlign=middle;fillColor=#FFF7ED;strokeColor=#FED7AA;rounded=1;arcSize=8;spacingLeft=10;"
          vertex="1" parent="1"><mxGeometry x="60" y="910" width="2080" height="30" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
